# 카카오 개발자 콘솔(https://developers.kakao.com) > 내 애플리케이션 > 앱 키 > JavaScript 키
# 이 파일을 .env.local로 복사한 뒤 실제 키를 넣으세요. (.env.local은 git에 커밋되지 않습니다)
VITE_KAKAO_MAP_KEY=

# 배포된 백엔드(Ma_BE) 주소. 로컬 개발은 비워두면 vite.config.js 프록시(/api → :8081)를 그대로 씀.
# 배포 환경에서만 실제 백엔드 URL로 설정 (예: https://ma-be-1.onrender.com)
VITE_API_BASE_URL=
